{
  "manifest_version": 3,
  "name": "Unity Job Mailer",
  "version": "1.3.1",
  "description": "Send job application emails through your own Gmail account: background queue, follow-ups, bounce and reply tracking.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unity Job Mailer"
  },
  "options_page": "options.html",
  "permissions": [
    "identity",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://dns.google/*"
  ],
  "oauth2": {
    "client_id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/drive.appdata",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}