{
  "manifest_version": 3,
  "name": "Unity Job Mailer",
  "version": "1.2.0",
  "description": "Send Unity job application emails through your own Gmail account using the Gmail API.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unity Job Mailer"
  },
  "options_page": "options.html",
  "permissions": ["identity", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "545364115428-ng9ck2u1u46mnq6evaerb6n3hi9ivec5.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
